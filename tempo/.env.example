# Copy to .env and fill in. Never commit your real .env.
PASSCODE=change-me
# OR, to avoid keeping the plaintext on disk, set a salted hash instead (wins over PASSCODE).
# Generate:  node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');console.log(s+':'+c.createHash('sha256').update(s+process.argv[1]).digest('hex'))" 'your-passcode'
# PASSCODE_HASH=salt:hash
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=please-change-this-to-a-long-random-string
# Where the SQLite database lives (kept out of git).
DB_PATH=./data/tempo.sqlite
# Port (optional)
PORT=3000

# --- Web Push (optional) ---
# Leave these blank and Tempo generates a VAPID keypair on first run and stores it
# in the database, so push works out of the box. Set them explicitly if you want
# stable keys across a fresh database. Generate with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# Contact address embedded in push messages (mailto: or https:).
# VAPID_SUBJECT=mailto:you@example.com

# --- Google Calendar sync (optional) ---
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console,
# enable the Google Calendar API, and add the redirect URI:
#   https://YOUR-HOST/api/google/callback
# Then set these. Without them, Google sync stays hidden and ICS still works.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
